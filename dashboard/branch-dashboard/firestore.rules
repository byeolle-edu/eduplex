rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 직원 정보: 로그인한 사람은 전체 열람 가능, 본인 문서만 수정 가능(역할 필드는 변경 불가)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // 공지사항: 전체 열람, 작성/수정/삭제는 관리자만
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 일정: 전체 열람, 로그인한 사람 누구나 작성, 작성자 본인 또는 관리자만 수정/삭제
    match /schedule/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // 실적: 전체 열람, 로그인한 사람 누구나 작성, 작성자 본인 또는 관리자만 수정/삭제
    match /sales/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }
  }
}
